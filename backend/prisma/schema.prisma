// AtDoor - Hyperlocal Gig Platform
// Database Schema v1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum DefaultMode {
  CREATOR
  WORKER
  BOTH
}

enum ActiveMode {
  CREATOR
  WORKER
}

enum RoleName {
  ADMIN
  CREATOR
  WORKER
  MODERATOR
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id            Int          @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String       @unique
  phone         String       @unique
  dob           DateTime
  password      String
  avatar        String?
  defaultMode   DefaultMode?
  activeMode    ActiveMode   @default(CREATOR)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  userRoles           UserRole[]
  modeSwitches        ModeSwitch[]
  createdJobs         Job[]  @relation("CreatedJobs")
  acceptedJobs        Job[]  @relation("AcceptedJobs")
  categorySuggestions CategorySuggestion[]
  notifications       Notification[]
}

// ─────────────────────────────────────────
// ROLES
// ─────────────────────────────────────────

model Role {
  id          Int        @id @default(autoincrement())
  name        RoleName   @unique
  description String?
  createdAt   DateTime   @default(now())

  // Relations
  userRoles   UserRole[]
}

// ─────────────────────────────────────────
// USER ROLES (many to many)
// ─────────────────────────────────────────

model UserRole {
  id          Int       @id @default(autoincrement())
  userId      Int
  roleId      Int
  assignedAt  DateTime  @default(now())
  assignedBy  Int?

  // Relations
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

// ─────────────────────────────────────────
// MODE SWITCH HISTORY (for admin reports)
// ─────────────────────────────────────────

model ModeSwitch {
  id          Int        @id @default(autoincrement())
  userId      Int
  fromMode    ActiveMode
  toMode      ActiveMode
  switchedAt  DateTime   @default(now())

  // Relations
  user        User       @relation(fields: [userId], references: [id])
}
// ─────────────────────────────────────────
// ENUMS — Job Status & Contact Preference
// ─────────────────────────────────────────

enum JobStatus {
  PENDING
  PUBLISHED
  WORK_ACCEPTED
  WORK_STARTED
  WORK_ENDED
  PAYMENT_COMPLETED
  RESCHEDULED
  EXPIRED
  CANCELLED
}

enum ContactPreference {
  PHONE
  EMAIL
  CHAT_ONLY
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

// ─────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────

model Category {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  icon        String?
  status      CategoryStatus @default(ACTIVE)
  isOfficial  Boolean        @default(true)
  createdBy   Int?           // null = admin created
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  jobs        Job[]
  suggestions CategorySuggestion[] @relation("MergedCategory")
}

// ─────────────────────────────────────────
// CATEGORY SUGGESTION
// ─────────────────────────────────────────

model CategorySuggestion {
  id             Int              @id @default(autoincrement())
  suggestedName  String
  suggestedBy    Int
  status         SuggestionStatus @default(PENDING)
  mergedWithId   Int?
  reviewedBy     Int?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  user           User             @relation(fields: [suggestedBy], references: [id])
  mergedWith     Category?        @relation("MergedCategory", fields: [mergedWithId], references: [id])
  jobs           Job[]
}

// ─────────────────────────────────────────
// JOB
// ─────────────────────────────────────────

model Job {
  id                  Int               @id @default(autoincrement())
  title               String
  description         String            @db.Text
  categoryId          Int?
  suggestionId        Int?
  creatorId           Int
  workerId            Int?  
  budgetMin           Float?
  budgetMax           Float?
  location            String
  startTime           DateTime
  endTime             DateTime
  status              JobStatus         @default(PUBLISHED)
  contactPreference   ContactPreference @default(CHAT_ONLY)
  expiresAt           Int               @default(7)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations
  category            Category?         @relation(fields: [categoryId], references: [id])
  suggestion          CategorySuggestion? @relation(fields: [suggestionId], references: [id])
  creator             User              @relation("CreatedJobs", fields: [creatorId], references: [id])
  worker              User?             @relation("AcceptedJobs", fields: [workerId], references: [id])
  photos              JobPhoto[]
  notifications       Notification[]
}

// ─────────────────────────────────────────
// JOB PHOTO
// ─────────────────────────────────────────

model JobPhoto {
  id        Int      @id @default(autoincrement())
  jobId     Int
  photoUrl  String
  createdAt DateTime @default(now())

  // Relations
  job       Job      @relation(fields: [jobId], references: [id])
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  jobId     Int?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id])
  job       Job?     @relation(fields: [jobId], references: [id])
}