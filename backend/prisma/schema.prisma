// AtDoor - Hyperlocal Gig Platform
// Database Schema v1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum DefaultMode {
  CREATOR
  WORKER
  BOTH
}

enum ActiveMode {
  CREATOR
  WORKER
}

enum RoleName {
  ADMIN
  CREATOR
  WORKER
  MODERATOR
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id            Int          @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String       @unique
  phone         String       @unique
  dob           DateTime
  password      String
  avatar        String?
  defaultMode   DefaultMode?
  activeMode    ActiveMode   @default(CREATOR)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  userRoles           UserRole[]
  modeSwitches        ModeSwitch[]
  createdJobs         Job[]  @relation("CreatedJobs")
  acceptedJobs        Job[]  @relation("AcceptedJobs")
  skills              Skill[]  @relation("WorkerSkills")
  categorySuggestions CategorySuggestion[]
  notifications       Notification[]
  ratingsGiven        Rating[]  @relation("RatingsGiven")
  ratingsReceived     Rating[]  @relation("RatingsReceived")
}

// ─────────────────────────────────────────
// ROLES
// ─────────────────────────────────────────

model Role {
  id          Int        @id @default(autoincrement())
  name        RoleName   @unique
  description String?
  createdAt   DateTime   @default(now())

  // Relations
  userRoles   UserRole[]
}

// ─────────────────────────────────────────
// USER ROLES (many to many)
// ─────────────────────────────────────────

model UserRole {
  id          Int       @id @default(autoincrement())
  userId      Int
  roleId      Int
  assignedAt  DateTime  @default(now())
  assignedBy  Int?

  // Relations
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

// ─────────────────────────────────────────
// MODE SWITCH HISTORY (for admin reports)
// ─────────────────────────────────────────

model ModeSwitch {
  id          Int        @id @default(autoincrement())
  userId      Int
  fromMode    ActiveMode
  toMode      ActiveMode
  switchedAt  DateTime   @default(now())

  // Relations
  user        User       @relation(fields: [userId], references: [id])
}
// ─────────────────────────────────────────
// ENUMS — Job Status & Contact Preference
// ─────────────────────────────────────────

enum JobStatus {
  PENDING
  PUBLISHED
  WORK_ACCEPTED
  WORK_STARTED
  WORK_ENDED
  PAYMENT_COMPLETED
  RESCHEDULED
  EXPIRED
  CANCELLED
}

enum ContactPreference {
  PHONE
  EMAIL
  CHAT_ONLY
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

// ─────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────

model Category {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  icon        String?
  status      CategoryStatus @default(ACTIVE)
  isOfficial  Boolean        @default(true)
  createdBy   Int?           // null = admin created
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  jobs        Job[]
  skills      Skill[]
  suggestions CategorySuggestion[] @relation("MergedCategory")
}

// ─────────────────────────────────────────
// CATEGORY SUGGESTION
// ─────────────────────────────────────────

model CategorySuggestion {
  id             Int              @id @default(autoincrement())
  suggestedName  String
  suggestedBy    Int
  status         SuggestionStatus @default(PENDING)
  mergedWithId   Int?
  reviewedBy     Int?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  user           User             @relation(fields: [suggestedBy], references: [id])
  mergedWith     Category?        @relation("MergedCategory", fields: [mergedWithId], references: [id])
  jobs           Job[]
}

// ─────────────────────────────────────────
// JOB
// ─────────────────────────────────────────

model Job {
  id                  Int               @id @default(autoincrement())
  title               String
  description         String            @db.Text
  categoryId          Int?
  suggestionId        Int?
  creatorId           Int
  workerId            Int?  
  budgetMin           Float?
  budgetMax           Float?
  location            String
  startTime           DateTime
  endTime             DateTime
  status              JobStatus         @default(PUBLISHED)
  contactPreference   ContactPreference @default(CHAT_ONLY)
  expiresAt           Int               @default(7)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workStartedAt           DateTime?
  workEndedAt             DateTime?
  startAcceptedByCreator  Boolean   @default(false)
  startAcceptedByWorker   Boolean   @default(false)
  endAcceptedByCreator    Boolean   @default(false)
  endAcceptedByWorker     Boolean   @default(false)
  workLogs                JobWorkLog[]

  // Relations
  category            Category?         @relation(fields: [categoryId], references: [id])
  suggestion          CategorySuggestion? @relation(fields: [suggestionId], references: [id])
  creator             User              @relation("CreatedJobs", fields: [creatorId], references: [id])
  worker              User?             @relation("AcceptedJobs", fields: [workerId], references: [id])
  photos              JobPhoto[]
  notifications       Notification[]
  ratings             Rating[]
  agreedAmount        Float?
  negotiations        JobNegotiation[]
}

// ─────────────────────────────────────────
// JOB PHOTO
// ─────────────────────────────────────────

model JobPhoto {
  id        Int      @id @default(autoincrement())
  jobId     Int
  photoUrl  String
  createdAt DateTime @default(now())

  // Relations
  job       Job      @relation(fields: [jobId], references: [id])
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  jobId     Int?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id])
  job       Job?     @relation(fields: [jobId], references: [id])
}
// ─────────────────────────────────────────
// ENUMS — Skill
// ─────────────────────────────────────────

enum WorkingDaysType {
  DAILY
  SPECIFIC_DAYS
  SPECIFIC_DATES
}

enum WorkingTimeSlot {
  ANYTIME
  MORNING
  EVENING
  NIGHT
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
  CUSTOM
}

enum PricingType {
  FIXED
  RANGE
}

enum ProjectPreference {
  ONSITE
  REMOTE
  ANY
}

enum PreferredCommunication {
  CHAT
  EMAIL
  PHONE
  ANY
}

enum SkillStatus {
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────
// SKILL (worker skill profile — many per worker)
// ─────────────────────────────────────────

model Skill {
  id                     Int                     @id @default(autoincrement())
  workerId               Int
  categoryId             Int?
  suggestedCategoryName  String?

  skillTitle             String
  description            String                  @db.Text
  residenceLocation      String

  // Working days
  workingDaysType        WorkingDaysType?
  preferredDays          Json?                   // ["MON","WED","FRI"]
  preferredDates         Json?                   // ["2026-10-01","2026-10-05"]

  // Working time
preferredTimes         Json?                   // ["MORNING","EVENING"]

  // Preferred locations (tags)
  preferredLocations     Json?                   // ["Kochi","Kottayam"]

  // Working type (multi-select)
  workingTypes           Json?                   // ["HOURLY","CONTRACT"]

  // Experience
  experienceLevel        ExperienceLevel?
  experienceYears        Int?
  experienceMonths       Int?

  // Pricing
  pricingType            PricingType?
  priceFixed             Float?
  priceMin               Float?
  priceMax               Float?

  // Languages
  languages              Json?                   // ["English","Malayalam"]

  education              String?
  projectPreference      ProjectPreference?
  preferredCommunication PreferredCommunication?
  aboutDescription       String?                 @db.Text

  isAvailable            Boolean                 @default(true)
  status                 SkillStatus             @default(ACTIVE)

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  // Relations
  worker                 User                    @relation("WorkerSkills", fields: [workerId], references: [id])
  category               Category?               @relation(fields: [categoryId], references: [id])
  portfolioLinks         SkillPortfolioLink[]
  certifications         SkillCertification[]
}

// ─────────────────────────────────────────
// SKILL PORTFOLIO LINK (repeatable)
// ─────────────────────────────────────────

model SkillPortfolioLink {
  id        Int      @id @default(autoincrement())
  skillId   Int
  url       String
  createdAt DateTime @default(now())

  skill     Skill    @relation(fields: [skillId], references: [id])
}

// ─────────────────────────────────────────
// SKILL CERTIFICATION (repeatable)
// ─────────────────────────────────────────

model SkillCertification {
  id        Int      @id @default(autoincrement())
  skillId   Int
  name      String
  issuer    String?
  createdAt DateTime @default(now())

  skill     Skill    @relation(fields: [skillId], references: [id])
}
enum WorkLogType {
  START
  RESCHEDULE
  EXTENSION
  MARK_DONE
}

enum WorkLogStatus {
  PENDING
  ACCEPTED
}

model JobWorkLog {
  id            Int           @id @default(autoincrement())
  jobId         Int
  type          WorkLogType
  proposedBy    Int
  acceptedBy    Int?
  oldStartTime  DateTime?
  oldEndTime    DateTime?
  newStartTime  DateTime?
  newEndTime    DateTime?
  status        WorkLogStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  acceptedAt    DateTime?

  job           Job           @relation(fields: [jobId], references: [id])
}

// ─────────────────────────────────────────
// RATING (bidirectional, per job)
// ─────────────────────────────────────────

enum RatingDirection {
  CREATOR_TO_WORKER
  WORKER_TO_CREATOR
}

model Rating {
  id          Int             @id @default(autoincrement())
  jobId       Int
  fromUserId  Int
  toUserId    Int
  direction   RatingDirection
  stars       Int
  comment     String?
  createdAt   DateTime        @default(now())

  job         Job             @relation(fields: [jobId], references: [id])
  fromUser    User            @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUser      User            @relation("RatingsReceived", fields: [toUserId], references: [id])

  @@unique([jobId, direction])
}
// ─────────────────────────────────────────
// JOB NEGOTIATION
// ─────────────────────────────────────────

enum NegotiationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model JobNegotiation {
  id          Int               @id @default(autoincrement())
  jobId       Int
  proposedBy  Int
  amount      Float
  status      NegotiationStatus @default(PENDING)
  respondedBy Int?
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  job         Job               @relation(fields: [jobId], references: [id])
}